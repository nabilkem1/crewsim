# Run output — the parameter store and HTML reports. Created on first write, so
# this directory is absent in a fresh checkout. Inputs live elsewhere: the corpus
# ships committed at src/crewsim/data/corpus/, and the scripts that build it are
# committed under tools/.
output/

# Runtime job/metadata store created by src/crewsim/api/db.py on first request.
# A local sqlite file, not an input — never tracked.
crewsim_metadata.db

